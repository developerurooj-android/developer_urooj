<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/doctor_card_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_16"
    android:layout_marginBottom="@dimen/space_8"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/radius_xlarge"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@color/md_theme_light_surfaceVariant"
    app:strokeWidth="1dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_12">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/doctor_card_image_height">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDoctor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_doctor"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.RoundedMedium"
                android:contentDescription="Doctor photo" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/viewOnlineDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/space_8"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_full"
                app:cardElevation="@dimen/elevation_low"
                app:strokeWidth="0dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_8"
                    android:paddingVertical="2dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="@dimen/space_4"
                        android:background="@drawable/bg_online_dot_bordered" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Online"
                        android:textColor="@color/success_green"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/space_8"
                app:cardBackgroundColor="#1565C0"
                app:cardCornerRadius="@dimen/radius_full"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_8"
                    android:paddingVertical="3dp">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/white"
                        android:contentDescription="Star" />

                    <TextView
                        android:id="@+id/tvRatingBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:fontFamily="sans-serif-black"
                        android:text="4.8"
                        android:textColor="@color/white"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDoctorName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:text="Dr. Name"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_medium"
                tools:text="Dr. Wilson" />

            <ImageView
                android:id="@+id/ivVerified"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="@dimen/space_4"
                android:src="@drawable/ic_verified"
                app:tint="@color/md_theme_light_primary"
                android:visibility="gone"
                tools:visibility="visible"
                android:contentDescription="Verified" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSpecialty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Cardiologist"
            android:textColor="@color/md_theme_light_primary"
            android:textSize="@dimen/text_caption"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Cardiologist" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_location"
                app:tint="@color/text_hint"
                android:contentDescription="Location" />

            <TextView
                android:id="@+id/tvHospital"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="City Hospital"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_label"
                tools:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnFavourite"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_favourite"
                app:tint="@color/md_theme_light_outline"
                android:contentDescription="Favorite" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_star"
                app:tint="@color/warning_orange"
                android:contentDescription="Rating" />

            <TextView
                android:id="@+id/tvRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="4.9"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="(120)"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
