<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/layoutControls"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivDoctor"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/ic_doctor"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
            app:strokeColor="#4DFFFFFF"
            app:strokeWidth="4dp" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Dr. Sarah Miller"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black" />

        <Chronometer
            android:id="@+id/chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#B3FFFFFF"
            android:textSize="16sp" />

        <!-- For compatibility -->
        <TextView android:id="@+id/tvStatus" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fabCustomSize="56dp"
            app:srcCompat="@drawable/ic_mic"
            app:tint="@color/white"
            app:backgroundTint="#4DFFFFFF"
            app:elevation="0dp"
            android:contentDescription="Mute" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnEndCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            app:fabCustomSize="72dp"
            app:srcCompat="@drawable/ic_call_end"
            app:tint="@color/white"
            app:backgroundTint="@color/md_theme_light_error"
            app:elevation="4dp"
            android:contentDescription="End Call" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSpeaker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fabCustomSize="56dp"
            app:srcCompat="@drawable/ic_speaker"
            app:tint="@color/white"
            app:backgroundTint="#4DFFFFFF"
            app:elevation="0dp"
            android:contentDescription="Speaker" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
