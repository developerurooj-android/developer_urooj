<?xml version="1.0" encoding="utf-8"?>
<!--
  ic_arrow_forward.xml - Simple rightward chevron arrow icon.
  CONCEPT: Vector Drawables
  Android's VectorDrawable uses SVG-like path data to render resolution-independent
  graphics. A single XML file renders crisply at EVERY screen density (mdpi → xxxhdpi),
  which is far more efficient than shipping 5 separate PNG files per icon.
  - android:viewportSize defines the logical "canvas" coordinates. Path coordinates
    below are relative to this 24x24 grid, NOT pixels.
  - android:fillColor=tintable via the button's app:iconTint attribute in the layout.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Rightward-pointing chevron: two diagonal strokes forming a V-shape -->
    <path
        android:fillColor="#1976D2"
        android:pathData="M12,4l-1.41,1.41L16.17,11H4v2h12.17l-5.58,5.59L12,20l8,-8z" />

</vector>
