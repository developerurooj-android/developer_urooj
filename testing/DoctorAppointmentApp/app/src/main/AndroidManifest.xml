<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DoctorAppointmentApp"
        tools:targetApi="31">

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DoctorAppointmentApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding -->
        <activity
            android:name=".activities.OnboardingActivity"
            android:exported="false" />

        <!-- Legacy host -->
        <activity
            android:name=".activities.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Authentication -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Home Screens -->
        <activity
            android:name=".activities.PatientHomeActivity"
            android:exported="false" />

        <activity
            android:name=".activities.DoctorHomeActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AdminDashboardActivity"
            android:exported="false" />

        <!-- Doctor Screens -->
        <activity
            android:name=".activities.DoctorListActivity"
            android:exported="false" />

        <activity
            android:name=".activities.DoctorDetailsActivity"
            android:exported="false" />

        <!-- Appointments -->
        <activity
            android:name=".activities.AppointmentsActivity"
            android:exported="false" />

        <!-- Appointment Details -->
        <activity
            android:name=".activities.AppointmentDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Payment -->
        <activity
            android:name=".activities.PaymentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.PaymentHistoryActivity"
            android:exported="false" />

        <!-- Chat -->
        <activity
            android:name=".activities.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Calls -->
        <activity
            android:name=".activities.AudioCallActivity"
            android:exported="false" />

        <activity
            android:name=".activities.VideoCallActivity"
            android:exported="false" />

        <!-- Medical Records -->
        <activity
            android:name=".activities.MedicalReportsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.MedicalHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".activities.PrescriptionActivity"
            android:exported="false" />

        <!-- Profile & Settings -->
        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.RateDoctorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
