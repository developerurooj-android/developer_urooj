<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/primary_dark"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvExpression"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:padding="8dp"
        android:text=""
        android:textColor="@color/text_expression"
        android:textSize="24sp"
        android:maxLines="2"
        android:ellipsize="start" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:padding="8dp"
        android:text="0"
        android:textColor="@color/text_result"
        android:textSize="48sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginVertical="16dp"/>

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/btnAC" style="@style/ActionButton" android:text="@string/ac" />
        <Button android:id="@+id/btnDelete" style="@style/ActionButton" android:text="@string/del" />
        <Button android:id="@+id/btnPercent" style="@style/ActionButton" android:text="@string/percent" />
        <Button android:id="@+id/btnDivide" style="@style/OperatorButton" android:text="@string/divide" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/btn7" style="@style/CalculatorButton" android:text="@string/digit_7" />
        <Button android:id="@+id/btn8" style="@style/CalculatorButton" android:text="@string/digit_8" />
        <Button android:id="@+id/btn9" style="@style/CalculatorButton" android:text="@string/digit_9" />
        <Button android:id="@+id/btnMultiply" style="@style/OperatorButton" android:text="@string/multiply" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/btn4" style="@style/CalculatorButton" android:text="@string/digit_4" />
        <Button android:id="@+id/btn5" style="@style/CalculatorButton" android:text="@string/digit_5" />
        <Button android:id="@+id/btn6" style="@style/CalculatorButton" android:text="@string/digit_6" />
        <Button android:id="@+id/btnSubtract" style="@style/OperatorButton" android:text="@string/subtract" />
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/btn1" style="@style/CalculatorButton" android:text="@string/digit_1" />
        <Button android:id="@+id/btn2" style="@style/CalculatorButton" android:text="@string/digit_2" />
        <Button android:id="@+id/btn3" style="@style/CalculatorButton" android:text="@string/digit_3" />
        <Button android:id="@+id/btnAdd" style="@style/OperatorButton" android:text="@string/add" />
    </LinearLayout>

    <!-- Row 5 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/btnPlusMinus" style="@style/CalculatorButton" android:text="@string/plus_minus" />
        <Button android:id="@+id/btn0" style="@style/CalculatorButton" android:text="@string/digit_0" />
        <Button android:id="@+id/btnDecimal" style="@style/CalculatorButton" android:text="@string/decimal" />
        <Button android:id="@+id/btnEqual" style="@style/OperatorButton" android:text="@string/equal" />
    </LinearLayout>

</LinearLayout>